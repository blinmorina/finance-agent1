# Copy to `.env` and set only the keys for providers you plan to use.
# `.env` overrides environment variables already set in your shell.

# ── Choose provider (optional — auto-detects from the first API key below) ──
# openai | anthropic | google | moonshot | openrouter | custom
FINANCE_AGENT_PROVIDER=moonshot

# Model id for the selected provider (see README for examples)
FINANCE_AGENT_MODEL=kimi-k2.6

# ── LLM API keys (set one or more) ───────────────────────────────────────────

# OpenAI (ChatGPT) — https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# Optional: responses (default) or chat_completions
# OPENAI_API_MODE=responses

# Anthropic (Claude) — https://console.anthropic.com/
# Uses Anthropic's OpenAI-compatible API surface.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/

# Google Gemini — https://aistudio.google.com/apikey
# GOOGLE_API_KEY=
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Moonshot (Kimi) — https://platform.moonshot.ai/
MOONSHOT_API_KEY=your_moonshot_api_key_here
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# OpenRouter (many models, one key) — https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# FINANCE_AGENT_MODEL=openai/gpt-4o

# Any OpenAI-compatible endpoint (local LM Studio, vLLM, etc.)
# FINANCE_AGENT_PROVIDER=custom
# CUSTOM_BASE_URL=http://localhost:1234/v1
# CUSTOM_API_KEY=not-needed-or-your-key
# FINANCE_AGENT_MODEL=your-local-model

# ── Data tools (no paid keys required for defaults) ──────────────────────────

# SEC EDGAR fair-access policy: include contact email
SEC_USER_AGENT=Finance Agent your-email@example.com
